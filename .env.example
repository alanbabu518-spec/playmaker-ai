# --- Postgres (used by docker-compose and the backend) ---
POSTGRES_USER=football
POSTGRES_PASSWORD=change_me
POSTGRES_DB=football_rag
DATABASE_URL=postgresql://football:change_me@localhost:5434/football_rag

# --- Gemini ---
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
GENERATION_MODEL=gemini-3.8-flash
GENERATION_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash

# --- Wikipedia (asks API clients to identify themselves) ---
WIKI_USER_AGENT=PlaymakerAI/0.1 (your-email@example.com)

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Secret for the /ingest endpoint.
ADMIN_API_KEY=